{
  "name": "fnirsi-ips3608-studio",
  "productName": "FNIRSI IPS3608 Studio",
  "version": "1.1.0",
  "description": "Professional Windows Desktop Studio & Control Suite for the FNIRSI IPS3608 Programmable DC Power Supply",
  "main": "src/main.js",
  "author": "Daddelgreis74",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --check src/main.js && node --check src/renderer/app.js && node --check src/renderer/protocol.js",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "dist:nsis": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.daddelgreis74.ips3608studio",
    "productName": "FNIRSI IPS3608 Studio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FNIRSI IPS3608 Studio",
      "uninstallDisplayName": "FNIRSI IPS3608 Studio"
    },
    "portable": {
      "artifactName": "FNIRSI-IPS3608-Studio-Portable-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
